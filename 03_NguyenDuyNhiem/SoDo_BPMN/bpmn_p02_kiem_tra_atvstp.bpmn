      <bpmndi:BPMNShape id="GW_ScoreCheck_di" bpmnElement="GW_ScoreCheck" isMarkerVisible="true"><dc:Bounds x="990" y="128" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="970" y="85" width="85" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
