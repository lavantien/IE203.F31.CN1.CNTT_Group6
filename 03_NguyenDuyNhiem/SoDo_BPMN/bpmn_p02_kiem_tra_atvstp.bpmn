      <bpmndi:BPMNShape id="GW_StoreAction_di" bpmnElement="GW_StoreAction" isMarkerVisible="true"><dc:Bounds x="1150" y="443" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="1130" y="400" width="85" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_FixJoin_di" bpmnElement="GW_FixJoin" isMarkerVisible="true"><dc:Bounds x="1260" y="443" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixErrors_di" bpmnElement="Task_FixErrors"><dc:Bounds x="1370" y="430" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ReAudit_di" bpmnElement="GW_ReAudit" isMarkerVisible="true"><dc:Bounds x="1580" y="128" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="1565" y="85" width="75" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ReAudit_Pass_di" bpmnElement="End_ReAudit_Pass"><dc:Bounds x="1710" y="132" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1685" y="175" width="85" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_OMJoin_di" bpmnElement="GW_OMJoin" isMarkerVisible="true"><dc:Bounds x="1260" y="743" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OM_Review_di" bpmnElement="Task_OM_Review"><dc:Bounds x="1370" y="730" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_OM_Decision_di" bpmnElement="GW_OM_Decision" isMarkerVisible="true"><dc:Bounds x="1580" y="743" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="1480" y="707" width="95" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CloseStore_di" bpmnElement="Task_CloseStore"><dc:Bounds x="1700" y="730" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_QA_Closed_di" bpmnElement="End_QA_Closed"><dc:Bounds x="1920" y="747" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1895" y="790" width="85" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_QA1_di" bpmnElement="F_QA1"><di:waypoint x="156" y="150" /><di:waypoint x="210" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_QA2_di" bpmnElement="F_QA2"><di:waypoint x="345" y="150" /><di:waypoint x="400" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_QA3_di" bpmnElement="F_QA3"><di:waypoint x="535" y="150" /><di:waypoint x="590" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_QA3b_di" bpmnElement="F_QA3b"><di:waypoint x="735" y="150" /><di:waypoint x="790" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_QA4_di" bpmnElement="F_QA4"><di:waypoint x="935" y="150" /><di:waypoint x="990" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Score_Pass_di" bpmnElement="F_Score_Pass"><di:waypoint x="1034" y="150" /><di:waypoint x="1110" y="150" /><bpmndi:BPMNLabel><dc:Bounds x="1040" y="130" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Score_Fail_di" bpmnElement="F_Score_Fail"><di:waypoint x="1012" y="172" /><di:waypoint x="1012" y="225" /><bpmndi:BPMNLabel><dc:Bounds x="1018" y="190" width="55" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_QA5_di" bpmnElement="F_QA5"><di:waypoint x="1012" y="295" /><di:waypoint x="1012" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_QA6_di" bpmnElement="F_QA6"><di:waypoint x="1080" y="465" /><di:waypoint x="1150" y="465" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Act_Light_di" bpmnElement="F_Act_Light"><di:waypoint x="1194" y="465" /><di:waypoint x="1260" y="465" /><bpmndi:BPMNLabel><dc:Bounds x="1200" y="445" width="45" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Act_Heavy_di" bpmnElement="F_Act_Heavy"><di:waypoint x="1172" y="487" /><di:waypoint x="1172" y="765" /><di:waypoint x="1260" y="765" /><bpmndi:BPMNLabel><dc:Bounds x="1178" y="620" width="50" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Fix_In_di" bpmnElement="F_Fix_In"><di:waypoint x="1304" y="465" /><di:waypoint x="1370" y="465" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_QA7_di" bpmnElement="F_QA7"><di:waypoint x="1440" y="430" /><di:waypoint x="1440" y="150" /><di:waypoint x="1580" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Re_Pass_di" bpmnElement="F_Re_Pass"><di:waypoint x="1624" y="150" /><di:waypoint x="1710" y="150" /><bpmndi:BPMNLabel><dc:Bounds x="1630" y="130" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Re_Fail_di" bpmnElement="F_Re_Fail"><di:waypoint x="1602" y="172" /><di:waypoint x="1602" y="630" /><di:waypoint x="1282" y="630" /><di:waypoint x="1282" y="743" /><bpmndi:BPMNLabel><dc:Bounds x="1420" y="610" width="50" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_OM_In_di" bpmnElement="F_OM_In"><di:waypoint x="1304" y="765" /><di:waypoint x="1370" y="765" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_QA8_di" bpmnElement="F_QA8"><di:waypoint x="1510" y="765" /><di:waypoint x="1580" y="765" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_OM_Close_di" bpmnElement="F_OM_Close"><di:waypoint x="1624" y="765" /><di:waypoint x="1700" y="765" /><bpmndi:BPMNLabel><dc:Bounds x="1635" y="745" width="45" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_OM_Warn_di" bpmnElement="F_OM_Warn"><di:waypoint x="1602" y="743" /><di:waypoint x="1602" y="540" /><di:waypoint x="1282" y="540" /><di:waypoint x="1282" y="487" /><bpmndi:BPMNLabel><dc:Bounds x="1420" y="520" width="55" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_QA9_di" bpmnElement="F_QA9"><di:waypoint x="1840" y="765" /><di:waypoint x="1920" y="765" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>