<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P10" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P10">
    <bpmn:participant id="Pool_OEM" name="NHÀ CUNG CẤP LINH KIỆN" processRef="Process_OEM" />
    <bpmn:participant id="Pool_HL" name="HIGHLANDS COFFEE - BẢO TRÌ &amp; HIỆU CHUẨN THIẾT BỊ QUẦY BAR" processRef="Process_HL_P10" />
    <bpmn:messageFlow id="MF_OrderPart" name="Gửi đơn linh kiện" sourceRef="Task_OrderPart" targetRef="Task_OEM_Supply" />
    <bpmn:messageFlow id="MF_DeliverPart" name="Giao linh kiện &amp; ron" sourceRef="Task_OEM_Supply" targetRef="Task_ReplaceParts" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OEM" isExecutable="false">
    <bpmn:laneSet id="LaneSet_OEM">
      <bpmn:lane id="Lane_OEM" name="Đại Lý Chính Hãng">
        <bpmn:flowNodeRef>Start_OEM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OEM_Supply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OEM</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_OEM" name="Đơn đặt linh kiện&#10;đã được gửi">
      <bpmn:outgoing>F_OEM_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OEM_Supply" name="Xuất kho &amp; giao vận&#10;linh kiện chính hãng">
      <bpmn:incoming>F_OEM_1</bpmn:incoming>
      <bpmn:outgoing>F_OEM_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_OEM" name="Linh kiện đã&#10;bàn giao">
      <bpmn:incoming>F_OEM_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_OEM_1" sourceRef="Start_OEM" targetRef="Task_OEM_Supply" />
    <bpmn:sequenceFlow id="F_OEM_2" sourceRef="Task_OEM_Supply" targetRef="End_OEM" />
  </bpmn:process>
  <bpmn:process id="Process_HL_P10" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HL_P10">
      <bpmn:lane id="Lane_Barista" name="Barista Trưởng (Lead Barista)">
        <bpmn:flowNodeRef>Start_P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DailyFlush</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Anomaly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonthlySched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ReqMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tech" name="Kỹ Thuật Viên Bảo Trì (Maintenance Dept)">
        <bpmn:flowNodeRef>Task_Arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ForkDiag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPressure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckTemp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckWater</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinDiag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ParamPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PartCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderPart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReplaceParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ReplaceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Calibrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_LoopJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestShot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TastePass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FineTune</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Store" name="Cửa Hàng Trưởng (Store Manager)">
        <bpmn:flowNodeRef>Task_InspectBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_StoreSign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReInspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P10_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_P10" name="Kế hoạch bảo trì&#10;đã đến hạn"><bpmn:outgoing>F_P10_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_DailyFlush" name="Vệ sinh backflush &amp;&#10;kiểm tra áp suất"><bpmn:incoming>F_P10_1</bpmn:incoming><bpmn:outgoing>F_P10_2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Anomaly" name="Phát hiện sự cố&#10;bất thường?"><bpmn:incoming>F_P10_2</bpmn:incoming><bpmn:outgoing>F_Ano_No</bpmn:outgoing><bpmn:outgoing>F_Ano_Yes</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_MonthlySched" name="Đăng ký lịch audit&#10;bảo trì định kỳ"><bpmn:incoming>F_Ano_No</bpmn:incoming><bpmn:outgoing>F_M_Merge</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_IssueTicket" name="Tạo ticket sửa chữa&#10;khẩn cấp trên app"><bpmn:incoming>F_Ano_Yes</bpmn:incoming><bpmn:outgoing>F_I_Merge</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_ReqMerge"><bpmn:incoming>F_M_Merge</bpmn:incoming><bpmn:incoming>F_I_Merge</bpmn:incoming><bpmn:outgoing>F_P10_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Arrive" name="Kỹ thuật viên tiếp nhận&#10;&amp; kiểm tra máy"><bpmn:incoming>F_P10_3</bpmn:incoming><bpmn:outgoing>F_P10_4</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="GW_ForkDiag" name="Phân luồng kiểm tra&#10;đa thông số"><bpmn:incoming>F_P10_4</bpmn:incoming><bpmn:outgoing>F_Diag_P</bpmn:outgoing><bpmn:outgoing>F_Diag_T</bpmn:outgoing><bpmn:outgoing>F_Diag_W</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="Task_CheckPressure" name="Đo áp suất nồi hơi (1.2 bar)&#10;&amp; bơm chiết xuất (9 bar)"><bpmn:incoming>F_Diag_P</bpmn:incoming><bpmn:outgoing>F_Join_P</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_CheckTemp" name="Đo nhiệt độ nước (93°C)&#10;&amp; thay ron cao su"><bpmn:incoming>F_Diag_T</bpmn:incoming><bpmn:outgoing>F_Join_T</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_CheckWater" name="Đo TDS nước (&lt;50ppm)&#10;&amp; kiểm tra lõi lọc"><bpmn:incoming>F_Diag_W</bpmn:incoming><bpmn:outgoing>F_Join_W</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="GW_JoinDiag" name="Đồng bộ kết quả&#10;kiểm tra"><bpmn:incoming>F_Join_P</bpmn:incoming><bpmn:incoming>F_Join_T</bpmn:incoming><bpmn:incoming>F_Join_W</bpmn:incoming><bpmn:outgoing>F_P10_5</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_ParamPass" name="Các thông số kỹ thuật&#10;đạt chuẩn?"><bpmn:incoming>F_P10_5</bpmn:incoming><bpmn:outgoing>F_Param_Pass</bpmn:outgoing><bpmn:outgoing>F_Param_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_PartCheck" name="Có sẵn linh kiện&#10;trong hộp đồ nghề?"><bpmn:incoming>F_Param_Fail</bpmn:incoming><bpmn:outgoing>F_Part_Stock</bpmn:outgoing><bpmn:outgoing>F_Part_Order</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_OrderPart" name="Gửi đơn yêu cầu&#10;linh kiện khẩn cấp"><bpmn:incoming>F_Part_Order</bpmn:incoming><bpmn:outgoing>F_Wait_Deliver</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ReplaceParts" name="Thay thế linh kiện, ron&#10;&amp; vệ sinh nồi hơi"><bpmn:incoming>F_Part_Stock</bpmn:incoming><bpmn:incoming>F_Wait_Deliver</bpmn:incoming><bpmn:outgoing>F_Rep_Done</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_ReplaceMerge"><bpmn:incoming>F_Param_Pass</bpmn:incoming><bpmn:incoming>F_Rep_Done</bpmn:incoming><bpmn:outgoing>F_P10_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Calibrate" name="Hiệu chuẩn áp suất &amp;&#10;độ mịn máy xay hạt"><bpmn:incoming>F_P10_6</bpmn:incoming><bpmn:outgoing>F_P10_7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_LoopJoin"><bpmn:incoming>F_P10_7</bpmn:incoming><bpmn:incoming>F_Fine_Back</bpmn:incoming><bpmn:incoming>F_Re_Back</bpmn:incoming><bpmn:outgoing>F_To_Shot</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_TestShot" name="Chiết xuất 3 shot espresso&#10;mẫu &amp; đo tỷ lệ TDS"><bpmn:incoming>F_To_Shot</bpmn:incoming><bpmn:outgoing>F_P10_8</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_TastePass" name="Shot cà phê đạt&#10;chuẩn hương vị?"><bpmn:incoming>F_P10_8</bpmn:incoming><bpmn:outgoing>F_Taste_Pass</bpmn:outgoing><bpmn:outgoing>F_Taste_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_FineTune" name="Tinh chỉnh lại cỡ xay&#10;&amp; nhiệt độ nước"><bpmn:incoming>F_Taste_Fail</bpmn:incoming><bpmn:outgoing>F_Fine_Back</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_InspectBar" name="Cửa hàng trưởng test&#10;thử vị &amp; nghiệm thu"><bpmn:incoming>F_Taste_Pass</bpmn:incoming><bpmn:outgoing>F_P10_9</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_StoreSign" name="Cửa hàng trưởng&#10;đồng ý nghiệm thu?"><bpmn:incoming>F_P10_9</bpmn:incoming><bpmn:outgoing>F_Sign_Pass</bpmn:outgoing><bpmn:outgoing>F_Sign_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReInspect" name="Yêu cầu căn chỉnh lại&#10;thông số chưa đạt"><bpmn:incoming>F_Sign_Fail</bpmn:incoming><bpmn:outgoing>F_Re_Back</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_SignReport" name="Ký biên bản bảo trì &amp;&#10;cập nhật sổ theo dõi"><bpmn:incoming>F_Sign_Pass</bpmn:incoming><bpmn:outgoing>F_P10_10</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_P10_Success" name="Máy pha cà phê đã&#10;bảo trì đạt chuẩn"><bpmn:incoming>F_P10_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_P10_1" sourceRef="Start_P10" targetRef="Task_DailyFlush" />
    <bpmn:sequenceFlow id="F_P10_2" sourceRef="Task_DailyFlush" targetRef="GW_Anomaly" />
    <bpmn:sequenceFlow id="F_Ano_No" name="Bình thường" sourceRef="GW_Anomaly" targetRef="Task_MonthlySched" />
    <bpmn:sequenceFlow id="F_Ano_Yes" name="Có sự cố" sourceRef="GW_Anomaly" targetRef="Task_IssueTicket" />
    <bpmn:sequenceFlow id="F_M_Merge" sourceRef="Task_MonthlySched" targetRef="GW_ReqMerge" />
    <bpmn:sequenceFlow id="F_I_Merge" sourceRef="Task_IssueTicket" targetRef="GW_ReqMerge" />
    <bpmn:sequenceFlow id="F_P10_3" sourceRef="GW_ReqMerge" targetRef="Task_Arrive" />
    <bpmn:sequenceFlow id="F_P10_4" sourceRef="Task_Arrive" targetRef="GW_ForkDiag" />
    <bpmn:sequenceFlow id="F_Diag_P" sourceRef="GW_ForkDiag" targetRef="Task_CheckPressure" />
    <bpmn:sequenceFlow id="F_Diag_T" sourceRef="GW_ForkDiag" targetRef="Task_CheckTemp" />
    <bpmn:sequenceFlow id="F_Diag_W" sourceRef="GW_ForkDiag" targetRef="Task_CheckWater" />
    <bpmn:sequenceFlow id="F_Join_P" sourceRef="Task_CheckPressure" targetRef="GW_JoinDiag" />
    <bpmn:sequenceFlow id="F_Join_T" sourceRef="Task_CheckTemp" targetRef="GW_JoinDiag" />
    <bpmn:sequenceFlow id="F_Join_W" sourceRef="Task_CheckWater" targetRef="GW_JoinDiag" />
    <bpmn:sequenceFlow id="F_P10_5" sourceRef="GW_JoinDiag" targetRef="GW_ParamPass" />
    <bpmn:sequenceFlow id="F_Param_Pass" name="Đạt chuẩn" sourceRef="GW_ParamPass" targetRef="GW_ReplaceMerge" />
    <bpmn:sequenceFlow id="F_Param_Fail" name="Cần thay thế" sourceRef="GW_ParamPass" targetRef="GW_PartCheck" />
    <bpmn:sequenceFlow id="F_Part_Stock" name="Có sẵn" sourceRef="GW_PartCheck" targetRef="Task_ReplaceParts" />
    <bpmn:sequenceFlow id="F_Part_Order" name="Cần đặt hàng" sourceRef="GW_PartCheck" targetRef="Task_OrderPart" />
    <bpmn:sequenceFlow id="F_Wait_Deliver" sourceRef="Task_OrderPart" targetRef="Task_ReplaceParts" />
    <bpmn:sequenceFlow id="F_Rep_Done" sourceRef="Task_ReplaceParts" targetRef="GW_ReplaceMerge" />
    <bpmn:sequenceFlow id="F_P10_6" sourceRef="GW_ReplaceMerge" targetRef="Task_Calibrate" />
    <bpmn:sequenceFlow id="F_P10_7" sourceRef="Task_Calibrate" targetRef="GW_LoopJoin" />
    <bpmn:sequenceFlow id="F_To_Shot" sourceRef="GW_LoopJoin" targetRef="Task_TestShot" />
    <bpmn:sequenceFlow id="F_P10_8" sourceRef="Task_TestShot" targetRef="GW_TastePass" />
    <bpmn:sequenceFlow id="F_Taste_Pass" name="Đạt chuẩn" sourceRef="GW_TastePass" targetRef="Task_InspectBar" />
    <bpmn:sequenceFlow id="F_Taste_Fail" name="Chưa đạt" sourceRef="GW_TastePass" targetRef="Task_FineTune" />
    <bpmn:sequenceFlow id="F_Fine_Back" name="Chỉnh lại" sourceRef="Task_FineTune" targetRef="GW_LoopJoin" />
    <bpmn:sequenceFlow id="F_P10_9" sourceRef="Task_InspectBar" targetRef="GW_StoreSign" />
    <bpmn:sequenceFlow id="F_Sign_Pass" name="Đồng ý ký" sourceRef="GW_StoreSign" targetRef="Task_SignReport" />
    <bpmn:sequenceFlow id="F_Sign_Fail" name="Chưa đạt chuẩn" sourceRef="GW_StoreSign" targetRef="Task_ReInspect" />
    <bpmn:sequenceFlow id="F_Re_Back" name="Căn chỉnh lại" sourceRef="Task_ReInspect" targetRef="GW_LoopJoin" />
    <bpmn:sequenceFlow id="F_P10_10" sourceRef="Task_SignReport" targetRef="End_P10_Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P10">
    <bpmndi:BPMNPlane id="BPMNPlane_P10" bpmnElement="Collaboration_P10">
      <bpmndi:BPMNShape id="Pool_OEM_di" bpmnElement="Pool_OEM" isHorizontal="true"><dc:Bounds x="40" y="40" width="3000" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OEM_di" bpmnElement="Lane_OEM" isHorizontal="true"><dc:Bounds x="70" y="40" width="2970" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_OEM_di" bpmnElement="Start_OEM"><dc:Bounds x="1380" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1355" y="148" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OEM_Supply_di" bpmnElement="Task_OEM_Supply"><dc:Bounds x="1480" y="90" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OEM_di" bpmnElement="End_OEM"><dc:Bounds x="1680" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1660" y="148" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_HL_di" bpmnElement="Pool_HL" isHorizontal="true"><dc:Bounds x="40" y="240" width="3000" height="760" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Barista_di" bpmnElement="Lane_Barista" isHorizontal="true"><dc:Bounds x="70" y="240" width="2970" height="210" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Tech_di" bpmnElement="Lane_Tech" isHorizontal="true"><dc:Bounds x="70" y="450" width="2970" height="345" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Store_di" bpmnElement="Lane_Store" isHorizontal="true"><dc:Bounds x="70" y="795" width="2970" height="205" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_P10_di" bpmnElement="Start_P10"><dc:Bounds x="120" y="322" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="95" y="365" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DailyFlush_di" bpmnElement="Task_DailyFlush"><dc:Bounds x="210" y="305" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Anomaly_di" bpmnElement="GW_Anomaly" isMarkerVisible="true"><dc:Bounds x="400" y="318" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="330" y="265" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MonthlySched_di" bpmnElement="Task_MonthlySched"><dc:Bounds x="520" y="265" width="140" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IssueTicket_di" bpmnElement="Task_IssueTicket"><dc:Bounds x="520" y="355" width="140" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ReqMerge_di" bpmnElement="GW_ReqMerge" isMarkerVisible="true"><dc:Bounds x="710" y="318" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Arrive_di" bpmnElement="Task_Arrive"><dc:Bounds x="800" y="525" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ForkDiag_di" bpmnElement="GW_ForkDiag"><dc:Bounds x="990" y="538" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="955" y="490" width="115" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckPressure_di" bpmnElement="Task_CheckPressure"><dc:Bounds x="1080" y="470" width="145" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckTemp_di" bpmnElement="Task_CheckTemp"><dc:Bounds x="1080" y="540" width="145" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckWater_di" bpmnElement="Task_CheckWater"><dc:Bounds x="1080" y="610" width="145" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_JoinDiag_di" bpmnElement="GW_JoinDiag"><dc:Bounds x="1270" y="538" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="1235" y="492" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ParamPass_di" bpmnElement="GW_ParamPass" isMarkerVisible="true"><dc:Bounds x="1370" y="538" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="1335" y="490" width="115" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_PartCheck_di" bpmnElement="GW_PartCheck" isMarkerVisible="true"><dc:Bounds x="1370" y="660" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="1270" y="662" width="95" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OrderPart_di" bpmnElement="Task_OrderPart"><dc:Bounds x="1480" y="710" width="140" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReplaceParts_di" bpmnElement="Task_ReplaceParts"><dc:Bounds x="1660" y="650" width="140" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ReplaceMerge_di" bpmnElement="GW_ReplaceMerge" isMarkerVisible="true"><dc:Bounds x="1840" y="538" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Calibrate_di" bpmnElement="Task_Calibrate"><dc:Bounds x="1920" y="525" width="140" height="70" /></bpmndi:BPMNShape>
