      <bpmndi:BPMNEdge id="F_Qual_Fail_di" bpmnElement="F_Qual_Fail"><di:waypoint x="1722" y="142" /><di:waypoint x="1722" y="210" /><di:waypoint x="1810" y="210" /><bpmndi:BPMNLabel><dc:Bounds x="1748" y="192" width="35" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
