<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P08" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P08">
    <bpmn:participant id="Pool_Store" name="HIGHLANDS COFFEE - CỬA HÀNG" processRef="Process_Store" />
    <bpmn:participant id="Pool_HO" name="HIGHLANDS COFFEE - HỘI SỞ SCM &amp; KẾ TOÁN" processRef="Process_HO" />
    <bpmn:participant id="Pool_Supp" name="ĐỐI TÁC CUNG ỨNG NGUYÊN LIỆU (B2B)" processRef="Process_Supp" />
    <bpmn:messageFlow id="M_PR_Pass" name="Gửi PR duyệt" sourceRef="Task_ReviewPR" targetRef="Task_ConsolidatePO" />
    <bpmn:messageFlow id="M_PO" name="Phát hành PO" sourceRef="Task_ConsolidatePO" targetRef="Task_PackGoods" />
    <bpmn:messageFlow id="M_Delivery" name="Giao xe lạnh" sourceRef="Task_ColdTruckDelivery" targetRef="Task_ReceiveGoods" />
    <bpmn:messageFlow id="M_GRN" name="Gửi GRN điện tử" sourceRef="Task_StoreInCold" targetRef="Task_3WayMatching" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Store" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Store">
      <bpmn:lane id="Lane_StoreK" name="Thủ Kho Cửa Hàng">
        <bpmn:flowNodeRef>Start_SCM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_StockSafety</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SCM_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_QualityInspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreInCold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Store_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Store_Fail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SM" name="Cửa Hàng Trưởng">
        <bpmn:flowNodeRef>Task_ReviewPR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PRAvail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SCM_Reject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_SCM" name="16:00 Kiểm kê"><bpmn:outgoing>F_S1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_CheckInventory" name="Kiểm kê tồn kho"><bpmn:incoming>F_S1</bpmn:incoming><bpmn:outgoing>F_S2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_StockSafety" name="Tồn &lt; ROP?"><bpmn:incoming>F_S2</bpmn:incoming><bpmn:outgoing>F_Stk_Yes</bpmn:outgoing><bpmn:outgoing>F_Stk_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_SCM_Done" name="Tồn an toàn"><bpmn:incoming>F_Stk_No</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_CreatePR" name="Lập PR mua sắm"><bpmn:incoming>F_Stk_Yes</bpmn:incoming><bpmn:outgoing>F_S3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ReviewPR" name="Duyệt đơn PR"><bpmn:incoming>F_S3</bpmn:incoming><bpmn:outgoing>F_S4</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_PRAvail" name="Duyệt?"><bpmn:incoming>F_S4</bpmn:incoming><bpmn:outgoing>F_PR_Approve</bpmn:outgoing><bpmn:outgoing>F_PR_Rej</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_SCM_Reject" name="Từ chối PR"><bpmn:incoming>F_PR_Rej</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_ReceiveGoods" name="Đo nhiệt độ xe lạnh &amp; đếm"><bpmn:incoming>F_PR_Approve</bpmn:incoming><bpmn:outgoing>F_S10</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_QualityInspect" name="Đạt chuẩn?"><bpmn:incoming>F_S10</bpmn:incoming><bpmn:outgoing>F_Qual_Pass</bpmn:outgoing><bpmn:outgoing>F_Qual_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_StoreInCold" name="Nhập kho FIFO &amp; ký GRN"><bpmn:incoming>F_Qual_Pass</bpmn:incoming><bpmn:outgoing>F_S11</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Store_Done" name="Nhập kho xong"><bpmn:incoming>F_S11</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_RejectGoods" name="Trả hàng &amp; yêu cầu bù"><bpmn:incoming>F_Qual_Fail</bpmn:incoming><bpmn:outgoing>F_S_Fail</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Store_Fail" name="Từ chối hàng"><bpmn:incoming>F_S_Fail</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_S1" sourceRef="Start_SCM" targetRef="Task_CheckInventory" />
    <bpmn:sequenceFlow id="F_S2" sourceRef="Task_CheckInventory" targetRef="GW_StockSafety" />
    <bpmn:sequenceFlow id="F_Stk_Yes" name="Cần" sourceRef="GW_StockSafety" targetRef="Task_CreatePR" />
    <bpmn:sequenceFlow id="F_Stk_No" name="Đủ" sourceRef="GW_StockSafety" targetRef="End_SCM_Done" />
    <bpmn:sequenceFlow id="F_S3" sourceRef="Task_CreatePR" targetRef="Task_ReviewPR" />
    <bpmn:sequenceFlow id="F_S4" sourceRef="Task_ReviewPR" targetRef="GW_PRAvail" />
    <bpmn:sequenceFlow id="F_PR_Approve" name="Duyệt" sourceRef="GW_PRAvail" targetRef="Task_ReceiveGoods" />
    <bpmn:sequenceFlow id="F_PR_Rej" name="Hủy" sourceRef="GW_PRAvail" targetRef="End_SCM_Reject" />
    <bpmn:sequenceFlow id="F_S10" sourceRef="Task_ReceiveGoods" targetRef="GW_QualityInspect" />
    <bpmn:sequenceFlow id="F_Qual_Pass" name="Đạt" sourceRef="GW_QualityInspect" targetRef="Task_StoreInCold" />
    <bpmn:sequenceFlow id="F_Qual_Fail" name="Lỗi" sourceRef="GW_QualityInspect" targetRef="Task_RejectGoods" />
    <bpmn:sequenceFlow id="F_S11" sourceRef="Task_StoreInCold" targetRef="End_Store_Done" />
    <bpmn:sequenceFlow id="F_S_Fail" sourceRef="Task_RejectGoods" targetRef="End_Store_Fail" />
  </bpmn:process>
  <bpmn:process id="Process_HO" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_HO">
      <bpmn:lane id="Lane_SCMDept" name="Phòng Mua Hàng SCM"><bpmn:flowNodeRef>Start_HO</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConsolidatePO</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Acct" name="Kế Toán Thanh Toán"><bpmn:flowNodeRef>Task_3WayMatching</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_MatchPass</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Acct_Mismatch</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DisbursePay</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Acct_Paid</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_HO" name="Nhận PR"><bpmn:outgoing>FHO1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_ConsolidatePO" name="Gom đơn &amp; phát hành PO"><bpmn:incoming>FHO1</bpmn:incoming><bpmn:outgoing>FHO2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_3WayMatching" name="Đối soát 3 chiều (PO/GRN/Bill)"><bpmn:incoming>FHO2</bpmn:incoming><bpmn:outgoing>F_S12</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_MatchPass" name="Khớp 100%?"><bpmn:incoming>F_S12</bpmn:incoming><bpmn:outgoing>F_Match_Yes</bpmn:outgoing><bpmn:outgoing>F_Match_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Acct_Mismatch" name="Treo hồ sơ"><bpmn:incoming>F_Match_No</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_DisbursePay" name="Ủy nhiệm chi thanh toán"><bpmn:incoming>F_Match_Yes</bpmn:incoming><bpmn:outgoing>F_S13</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Acct_Paid" name="Quyết toán xong"><bpmn:incoming>F_S13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="FHO1" sourceRef="Start_HO" targetRef="Task_ConsolidatePO" />
    <bpmn:sequenceFlow id="FHO2" sourceRef="Task_ConsolidatePO" targetRef="Task_3WayMatching" />
    <bpmn:sequenceFlow id="F_S12" sourceRef="Task_3WayMatching" targetRef="GW_MatchPass" />
    <bpmn:sequenceFlow id="F_Match_Yes" name="Khớp" sourceRef="GW_MatchPass" targetRef="Task_DisbursePay" />
    <bpmn:sequenceFlow id="F_Match_No" name="Lệch" sourceRef="GW_MatchPass" targetRef="End_Acct_Mismatch" />
    <bpmn:sequenceFlow id="F_S13" sourceRef="Task_DisbursePay" targetRef="End_Acct_Paid" />
  </bpmn:process>
  <bpmn:process id="Process_Supp" isExecutable="false">
    <bpmn:startEvent id="Start_Supp" name="Nhận PO"><bpmn:outgoing>FSP1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_PackGoods" name="Đóng gói &amp; chuẩn bị xe"><bpmn:incoming>FSP1</bpmn:incoming><bpmn:outgoing>F_Supp1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ColdTruckDelivery" name="Vận chuyển giao hàng"><bpmn:incoming>F_Supp1</bpmn:incoming><bpmn:outgoing>FSP2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Supp_Done" name="Giao xong"><bpmn:incoming>FSP2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="FSP1" sourceRef="Start_Supp" targetRef="Task_PackGoods" />
    <bpmn:sequenceFlow id="F_Supp1" sourceRef="Task_PackGoods" targetRef="Task_ColdTruckDelivery" />
    <bpmn:sequenceFlow id="FSP2" sourceRef="Task_ColdTruckDelivery" targetRef="End_Supp_Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P08">
    <bpmndi:BPMNPlane id="BPMNPlane_P08" bpmnElement="Collaboration_P08">
