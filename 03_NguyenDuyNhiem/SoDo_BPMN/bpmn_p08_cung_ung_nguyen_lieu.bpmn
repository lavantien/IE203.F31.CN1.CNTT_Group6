      <bpmndi:BPMNEdge id="F_PR_Rej_di" bpmnElement="F_PR_Rej"><di:waypoint x="744" y="375" /><di:waypoint x="810" y="375" /><bpmndi:BPMNLabel><dc:Bounds x="760" y="357" width="35" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
