      <bpmndi:BPMNShape id="Task_Line1_Espresso_di" bpmnElement="Task_Line1_Espresso"><dc:Bounds x="500" y="650" width="150" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Line2_Freeze_di" bpmnElement="Task_Line2_Freeze"><dc:Bounds x="500" y="733" width="150" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Line3_Bakery_di" bpmnElement="Task_Line3_Bakery"><dc:Bounds x="500" y="815" width="150" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_KDSParallelJoin_di" bpmnElement="GW_KDSParallelJoin"><dc:Bounds x="710" y="743" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="694" y="721" width="77" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
