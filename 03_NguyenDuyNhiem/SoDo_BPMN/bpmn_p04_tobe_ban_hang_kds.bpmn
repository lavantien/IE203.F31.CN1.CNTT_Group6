      <bpmndi:BPMNShape id="Start_ToBe_di" bpmnElement="Start_ToBe"><dc:Bounds x="100" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="53" y="80" width="130" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
