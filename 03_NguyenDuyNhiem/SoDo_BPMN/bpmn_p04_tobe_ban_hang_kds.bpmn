      <bpmndi:BPMNEdge id="FS_Stk_No_di" bpmnElement="FS_Stk_No"><di:waypoint x="802" y="482" /><di:waypoint x="802" y="525" /><bpmndi:BPMNLabel><dc:Bounds x="810" y="496" width="35" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FS3_di" bpmnElement="FS3"><di:waypoint x="1180" y="460" /><di:waypoint x="1270" y="460" /></bpmndi:BPMNEdge>
