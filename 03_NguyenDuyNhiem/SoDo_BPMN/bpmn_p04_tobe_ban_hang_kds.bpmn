      <bpmndi:BPMNEdge id="FT1_di" bpmnElement="FT1"><di:waypoint x="136" y="130" /><di:waypoint x="190" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT_Ch_Kiosk_di" bpmnElement="FT_Ch_Kiosk"><di:waypoint x="212" y="108" /><di:waypoint x="212" y="95" /><di:waypoint x="290" y="95" /><bpmndi:BPMNLabel><dc:Bounds x="232" y="77" width="38" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT_Ch_App_di" bpmnElement="FT_Ch_App"><di:waypoint x="212" y="152" /><di:waypoint x="212" y="175" /><di:waypoint x="290" y="175" /><bpmndi:BPMNLabel><dc:Bounds x="234" y="157" width="35" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT_Kiosk_Join_di" bpmnElement="FT_Kiosk_Join"><di:waypoint x="430" y="95" /><di:waypoint x="502" y="95" /><di:waypoint x="502" y="108" /></bpmndi:BPMNEdge>
