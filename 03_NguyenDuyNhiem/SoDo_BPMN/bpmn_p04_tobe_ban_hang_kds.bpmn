      <bpmndi:BPMNEdge id="FT3_di" bpmnElement="FT3"><di:waypoint x="720" y="130" /><di:waypoint x="1040" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT4_di" bpmnElement="FT4"><di:waypoint x="1180" y="130" /><di:waypoint x="1270" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT5_di" bpmnElement="FT5"><di:waypoint x="1410" y="130" /><di:waypoint x="1780" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT6_di" bpmnElement="FT6"><di:waypoint x="1920" y="130" /><di:waypoint x="2010" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT7_di" bpmnElement="FT7"><di:waypoint x="2150" y="130" /><di:waypoint x="2240" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FS1_di" bpmnElement="FS1"><di:waypoint x="136" y="460" /><di:waypoint x="580" y="460" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FS2_di" bpmnElement="FS2"><di:waypoint x="720" y="460" /><di:waypoint x="780" y="460" /></bpmndi:BPMNEdge>
