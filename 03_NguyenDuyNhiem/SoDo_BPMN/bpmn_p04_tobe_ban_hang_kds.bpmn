      <bpmndi:BPMNShape id="End_Stock_Out_di" bpmnElement="End_Stock_Out"><dc:Bounds x="784" y="525" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="764" y="567" width="77" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AutoLockStock_di" bpmnElement="Task_AutoLockStock"><dc:Bounds x="1040" y="425" width="140" height="70" /></bpmndi:BPMNShape>
