<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P04_ToBe" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P04_ToBe">
    <bpmn:participant id="Pool_Cust_ToBe" name="Khách Hàng" processRef="Process_Cust_ToBe" />
    <bpmn:participant id="Pool_HL_ToBe" name="HIGHLANDS COFFEE (HỆ THỐNG SỐ HÓA)" processRef="Process_HL_ToBe" />
    <bpmn:messageFlow id="MT_SendOrder" name="Gửi giỏ hàng" sourceRef="Task_SubmitOrder" targetRef="Task_AutoVerifyStock" />
    <bpmn:messageFlow id="MT_PayReq" name="Tạo VietQR" sourceRef="Task_AutoLockStock" targetRef="Task_DigitalPayInstant" />
    <bpmn:messageFlow id="MT_PushReady" name="Push App &amp; TV" sourceRef="Task_AutoPushNotify" targetRef="Task_ReceiveNotify" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Cust_ToBe" isExecutable="false">
    <bpmn:startEvent id="Start_ToBe" name="Có nhu cầu gọi món"><bpmn:outgoing>FT1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_ChannelChoice" name="Kênh đặt món?"><bpmn:incoming>FT1</bpmn:incoming><bpmn:outgoing>FT_Ch_Kiosk</bpmn:outgoing><bpmn:outgoing>FT_Ch_App</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_KioskOrder" name="Tự đặt tại màn hình Kiosk"><bpmn:incoming>FT_Ch_Kiosk</bpmn:incoming><bpmn:outgoing>FT_Kiosk_Join</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AppPreOrder" name="Đặt trước qua Mobile App"><bpmn:incoming>FT_Ch_App</bpmn:incoming><bpmn:outgoing>FT_App_Join</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_PayChannelJoin"><bpmn:incoming>FT_Kiosk_Join</bpmn:incoming><bpmn:incoming>FT_App_Join</bpmn:incoming><bpmn:outgoing>FT2</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_SubmitOrder" name="Xác nhận giỏ hàng"><bpmn:incoming>FT2</bpmn:incoming><bpmn:outgoing>FT3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_DigitalPayInstant" name="Thanh toán VietQR / Thẻ"><bpmn:incoming>FT3</bpmn:incoming><bpmn:outgoing>FT4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_FindSeat" name="Khách tìm bàn ngồi &amp; xem TV"><bpmn:incoming>FT4</bpmn:incoming><bpmn:outgoing>FT5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ReceiveNotify" name="Nhận thông báo món đã xong"><bpmn:incoming>FT5</bpmn:incoming><bpmn:outgoing>FT6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_PickupSelfService" name="Đến quầy nhận khay đồ"><bpmn:incoming>FT6</bpmn:incoming><bpmn:outgoing>FT7</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_ToBe_Happy" name="Phục vụ hoàn tất"><bpmn:incoming>FT7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="FT1" sourceRef="Start_ToBe" targetRef="GW_ChannelChoice" />
    <bpmn:sequenceFlow id="FT_Ch_Kiosk" name="Kiosk" sourceRef="GW_ChannelChoice" targetRef="Task_KioskOrder" />
    <bpmn:sequenceFlow id="FT_Ch_App" name="App" sourceRef="GW_ChannelChoice" targetRef="Task_AppPreOrder" />
    <bpmn:sequenceFlow id="FT_Kiosk_Join" sourceRef="Task_KioskOrder" targetRef="GW_PayChannelJoin" />
    <bpmn:sequenceFlow id="FT_App_Join" sourceRef="Task_AppPreOrder" targetRef="GW_PayChannelJoin" />
    <bpmn:sequenceFlow id="FT2" sourceRef="GW_PayChannelJoin" targetRef="Task_SubmitOrder" />
    <bpmn:sequenceFlow id="FT3" sourceRef="Task_SubmitOrder" targetRef="Task_DigitalPayInstant" />
    <bpmn:sequenceFlow id="FT4" sourceRef="Task_DigitalPayInstant" targetRef="Task_FindSeat" />
    <bpmn:sequenceFlow id="FT5" sourceRef="Task_FindSeat" targetRef="Task_ReceiveNotify" />
    <bpmn:sequenceFlow id="FT6" sourceRef="Task_ReceiveNotify" targetRef="Task_PickupSelfService" />
    <bpmn:sequenceFlow id="FT7" sourceRef="Task_PickupSelfService" targetRef="End_ToBe_Happy" />
  </bpmn:process>
  <bpmn:process id="Process_HL_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HL_ToBe">
      <bpmn:lane id="Lane_Sys_ToBe" name="Hệ Thống Số Hóa (POS / Cloud ERP)">
        <bpmn:flowNodeRef>Start_Sys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoVerifyStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_StockCheckAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Stock_Out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoLockStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DispatchToKDS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoPushNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Sys_Success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bar_ToBe" name="Quầy Pha Chế (Điều Phối KDS)">
        <bpmn:flowNodeRef>Task_ReceiveKDSTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_KDSParallelFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Line1_Espresso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Line2_Freeze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Line3_Bakery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_KDSParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QuickAssemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PressKDSComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Sys" name="Nhận order"><bpmn:outgoing>FS1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_AutoVerifyStock" name="Kiểm tra tồn kho tức thì"><bpmn:incoming>FS1</bpmn:incoming><bpmn:outgoing>FS2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_StockCheckAuto" name="Đủ món?"><bpmn:incoming>FS2</bpmn:incoming><bpmn:outgoing>FS_Stk_Yes</bpmn:outgoing><bpmn:outgoing>FS_Stk_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Stock_Out" name="Báo hết món"><bpmn:incoming>FS_Stk_No</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_AutoLockStock" name="Khóa tồn kho BOM &amp; tạo VietQR"><bpmn:incoming>FS_Stk_Yes</bpmn:incoming><bpmn:outgoing>FS3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_DispatchToKDS" name="Điều phối đơn sang 3 trạm KDS"><bpmn:incoming>FS3</bpmn:incoming><bpmn:outgoing>FS4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ReceiveKDSTicket" name="Barista nhận order trên KDS"><bpmn:incoming>FS4</bpmn:incoming><bpmn:outgoing>FS5</bpmn:outgoing></bpmn:task>
    <bpmn:inclusiveGateway id="GW_KDSParallelFork" name="Phân loại trạm?"><bpmn:incoming>FS5</bpmn:incoming><bpmn:outgoing>FS_Esp</bpmn:outgoing><bpmn:outgoing>FS_Frz</bpmn:outgoing><bpmn:outgoing>FS_Bak</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:task id="Task_Line1_Espresso" name="Trạm 1: Espresso &amp; Phin"><bpmn:incoming>FS_Esp</bpmn:incoming><bpmn:outgoing>FS_J1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Line2_Freeze" name="Trạm 2: Xay Freeze &amp; kem"><bpmn:incoming>FS_Frz</bpmn:incoming><bpmn:outgoing>FS_J2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Line3_Bakery" name="Trạm 3: Nướng bánh mì que"><bpmn:incoming>FS_Bak</bpmn:incoming><bpmn:outgoing>FS_J3</bpmn:outgoing></bpmn:task>
    <bpmn:inclusiveGateway id="GW_KDSParallelJoin" name="Gom đơn KDS"><bpmn:incoming>FS_J1</bpmn:incoming><bpmn:incoming>FS_J2</bpmn:incoming><bpmn:incoming>FS_J3</bpmn:incoming><bpmn:outgoing>FS6</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:task id="Task_QuickAssemble" name="Gom món &amp; dán tem mã đơn"><bpmn:incoming>FS6</bpmn:incoming><bpmn:outgoing>FS7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_PressKDSComplete" name="Chạm 'Hoàn tất' trên KDS"><bpmn:incoming>FS7</bpmn:incoming><bpmn:outgoing>FS8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AutoPushNotify" name="Tự trừ kho &amp; Push chuông/App"><bpmn:incoming>FS8</bpmn:incoming><bpmn:outgoing>FS9</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Sys_Success" name="Đơn hàng hoàn tất"><bpmn:incoming>FS9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="FS1" sourceRef="Start_Sys" targetRef="Task_AutoVerifyStock" />
    <bpmn:sequenceFlow id="FS2" sourceRef="Task_AutoVerifyStock" targetRef="GW_StockCheckAuto" />
    <bpmn:sequenceFlow id="FS_Stk_Yes" name="Đủ" sourceRef="GW_StockCheckAuto" targetRef="Task_AutoLockStock" />
    <bpmn:sequenceFlow id="FS_Stk_No" name="Hết" sourceRef="GW_StockCheckAuto" targetRef="End_Stock_Out" />
    <bpmn:sequenceFlow id="FS3" sourceRef="Task_AutoLockStock" targetRef="Task_DispatchToKDS" />
    <bpmn:sequenceFlow id="FS4" sourceRef="Task_DispatchToKDS" targetRef="Task_ReceiveKDSTicket" />
    <bpmn:sequenceFlow id="FS5" sourceRef="Task_ReceiveKDSTicket" targetRef="GW_KDSParallelFork" />
    <bpmn:sequenceFlow id="FS_Esp" name="Espresso" sourceRef="GW_KDSParallelFork" targetRef="Task_Line1_Espresso" />
    <bpmn:sequenceFlow id="FS_Frz" name="Freeze" sourceRef="GW_KDSParallelFork" targetRef="Task_Line2_Freeze" />
    <bpmn:sequenceFlow id="FS_Bak" name="Bánh mì" sourceRef="GW_KDSParallelFork" targetRef="Task_Line3_Bakery" />
    <bpmn:sequenceFlow id="FS_J1" sourceRef="Task_Line1_Espresso" targetRef="GW_KDSParallelJoin" />
    <bpmn:sequenceFlow id="FS_J2" sourceRef="Task_Line2_Freeze" targetRef="GW_KDSParallelJoin" />
    <bpmn:sequenceFlow id="FS_J3" sourceRef="Task_Line3_Bakery" targetRef="GW_KDSParallelJoin" />
    <bpmn:sequenceFlow id="FS6" sourceRef="GW_KDSParallelJoin" targetRef="Task_QuickAssemble" />
    <bpmn:sequenceFlow id="FS7" sourceRef="Task_QuickAssemble" targetRef="Task_PressKDSComplete" />
    <bpmn:sequenceFlow id="FS8" sourceRef="Task_PressKDSComplete" targetRef="Task_AutoPushNotify" />
    <bpmn:sequenceFlow id="FS9" sourceRef="Task_AutoPushNotify" targetRef="End_Sys_Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P04_ToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_P04_ToBe" bpmnElement="Collaboration_P04_ToBe">
      <bpmndi:BPMNShape id="Pool_Cust_ToBe_di" bpmnElement="Pool_Cust_ToBe" isHorizontal="true"><dc:Bounds x="40" y="40" width="2300" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_HL_ToBe_di" bpmnElement="Pool_HL_ToBe" isHorizontal="true"><dc:Bounds x="40" y="330" width="2300" height="630" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sys_ToBe_di" bpmnElement="Lane_Sys_ToBe" isHorizontal="true"><dc:Bounds x="70" y="330" width="2270" height="290" /></bpmndi:BPMNShape>
