      <bpmndi:BPMNShape id="Start_Sys_di" bpmnElement="Start_Sys"><dc:Bounds x="100" y="442" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="83" y="422" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
