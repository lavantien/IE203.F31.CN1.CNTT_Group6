<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P05" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P05">
    <bpmn:participant id="Pool_CustR" name="Khách Hàng Hội Viên" processRef="Process_CustR" />
    <bpmn:participant id="Pool_HL" name="HIGHLANDS COFFEE" processRef="Process_HL_Loyalty" />
    <bpmn:messageFlow id="MR1" name="Xuất trình QR" sourceRef="Task_ShowQR" targetRef="Task_ScanMember" />
    <bpmn:messageFlow id="MR2" name="Báo số dư điểm" sourceRef="Task_QueryBalance" targetRef="Task_DecideRedeem" />
    <bpmn:messageFlow id="MR3" name="Đổi voucher" sourceRef="Task_PickVoucher" targetRef="Task_ApplyDiscount" />
    <bpmn:messageFlow id="MR4" name="Push App &amp; E-bill" sourceRef="Task_PushCongrats" targetRef="Task_ReceivePush" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CustR" isExecutable="false">
    <bpmn:startEvent id="Start_R" name="Muốn tích điểm"><bpmn:outgoing>FR1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_ShowQR" name="Mở App quét mã"><bpmn:incoming>FR1</bpmn:incoming><bpmn:outgoing>FR2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_DecideRedeem" name="Xem điểm &amp; chọn đổi"><bpmn:incoming>FR2</bpmn:incoming><bpmn:outgoing>FR3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_RedeemChoice" name="Đổi Voucher?"><bpmn:incoming>FR3</bpmn:incoming><bpmn:outgoing>FR_Red_Yes</bpmn:outgoing><bpmn:outgoing>FR_Red_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_PickVoucher" name="Chọn Voucher 30k/50k"><bpmn:incoming>FR_Red_Yes</bpmn:incoming><bpmn:outgoing>FR4</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_CustPayJoin"><bpmn:incoming>FR_Red_No</bpmn:incoming><bpmn:incoming>FR4</bpmn:incoming><bpmn:outgoing>FR5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_PayRemainder" name="Thanh toán phần còn lại"><bpmn:incoming>FR5</bpmn:incoming><bpmn:outgoing>FR6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ReceivePush" name="Nhận thông báo điểm"><bpmn:incoming>FR6</bpmn:incoming><bpmn:outgoing>FR7</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_R_Success" name="Hoàn tất"><bpmn:incoming>FR7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="FR1" sourceRef="Start_R" targetRef="Task_ShowQR" />
    <bpmn:sequenceFlow id="FR2" sourceRef="Task_ShowQR" targetRef="Task_DecideRedeem" />
    <bpmn:sequenceFlow id="FR3" sourceRef="Task_DecideRedeem" targetRef="GW_RedeemChoice" />
    <bpmn:sequenceFlow id="FR_Red_Yes" name="Đổi" sourceRef="GW_RedeemChoice" targetRef="Task_PickVoucher" />
    <bpmn:sequenceFlow id="FR_Red_No" name="Tích" sourceRef="GW_RedeemChoice" targetRef="GW_CustPayJoin" />
    <bpmn:sequenceFlow id="FR4" sourceRef="Task_PickVoucher" targetRef="GW_CustPayJoin" />
    <bpmn:sequenceFlow id="FR5" sourceRef="GW_CustPayJoin" targetRef="Task_PayRemainder" />
    <bpmn:sequenceFlow id="FR6" sourceRef="Task_PayRemainder" targetRef="Task_ReceivePush" />
    <bpmn:sequenceFlow id="FR7" sourceRef="Task_ReceivePush" targetRef="End_R_Success" />
  </bpmn:process>
  <bpmn:process id="Process_HL_Loyalty" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HL_Loyalty">
      <bpmn:lane id="Lane_POS" name="Hệ Thống POS &amp; Loyalty Engine">
        <bpmn:flowNodeRef>Start_HL_POS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScanMember</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MemberExist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QuickReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RegJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QueryBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyDiscount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalcPoints</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateTier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TierUpgrade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PushCongrats</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mkt" name="Phòng Marketing &amp; CRM">
        <bpmn:flowNodeRef>GW_MktJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogBehavior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MktSegment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PersonalPromo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MktEndJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Mkt_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_HL_POS" name="POS đọc mã"><bpmn:outgoing>FHL1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_ScanMember" name="Máy POS đọc mã QR"><bpmn:incoming>FHL1</bpmn:incoming><bpmn:outgoing>FHL2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_MemberExist" name="Đã có TK?"><bpmn:incoming>FHL2</bpmn:incoming><bpmn:outgoing>FHL_Mem_No</bpmn:outgoing><bpmn:outgoing>FHL_Mem_Yes</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_QuickReg" name="Đăng ký nhanh hội viên"><bpmn:incoming>FHL_Mem_No</bpmn:incoming><bpmn:outgoing>FHL_Reg_Done</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_RegJoin"><bpmn:incoming>FHL_Mem_Yes</bpmn:incoming><bpmn:incoming>FHL_Reg_Done</bpmn:incoming><bpmn:outgoing>FHL3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_QueryBalance" name="Truy vấn điểm Sen Vàng"><bpmn:incoming>FHL3</bpmn:incoming><bpmn:outgoing>FHL4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ApplyDiscount" name="Trừ điểm &amp; chiết khấu bill"><bpmn:incoming>FHL4</bpmn:incoming><bpmn:outgoing>FHL5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_CalcPoints" name="Tích lũy điểm mới"><bpmn:incoming>FHL5</bpmn:incoming><bpmn:outgoing>FHL6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_UpdateTier" name="Xét hạng thành viên"><bpmn:incoming>FHL6</bpmn:incoming><bpmn:outgoing>FHL7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_TierUpgrade" name="Thăng hạng?"><bpmn:incoming>FHL7</bpmn:incoming><bpmn:outgoing>FHL_Up_Yes</bpmn:outgoing><bpmn:outgoing>FHL_Up_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_PushCongrats" name="Gửi thông báo thăng hạng"><bpmn:incoming>FHL_Up_Yes</bpmn:incoming><bpmn:outgoing>FHL8</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_MktJoin"><bpmn:incoming>FHL_Up_No</bpmn:incoming><bpmn:incoming>FHL8</bpmn:incoming><bpmn:outgoing>FHL9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_LogBehavior" name="Ghi nhận lịch sử CRM"><bpmn:incoming>FHL9</bpmn:incoming><bpmn:outgoing>FHL10</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_MktSegment" name="Tiềm năng?"><bpmn:incoming>FHL10</bpmn:incoming><bpmn:outgoing>FHL_Mkt_Yes</bpmn:outgoing><bpmn:outgoing>FHL_Mkt_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_PersonalPromo" name="Gửi Push Voucher cá nhân"><bpmn:incoming>FHL_Mkt_Yes</bpmn:incoming><bpmn:outgoing>FHL11</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_MktEndJoin"><bpmn:incoming>FHL_Mkt_No</bpmn:incoming><bpmn:incoming>FHL11</bpmn:incoming><bpmn:outgoing>FHL12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Mkt_Done" name="Hoàn tất CRM"><bpmn:incoming>FHL12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="FHL1" sourceRef="Start_HL_POS" targetRef="Task_ScanMember" />
    <bpmn:sequenceFlow id="FHL2" sourceRef="Task_ScanMember" targetRef="GW_MemberExist" />
    <bpmn:sequenceFlow id="FHL_Mem_No" name="Chưa" sourceRef="GW_MemberExist" targetRef="Task_QuickReg" />
    <bpmn:sequenceFlow id="FHL_Mem_Yes" name="Có" sourceRef="GW_MemberExist" targetRef="GW_RegJoin" />
    <bpmn:sequenceFlow id="FHL_Reg_Done" sourceRef="Task_QuickReg" targetRef="GW_RegJoin" />
    <bpmn:sequenceFlow id="FHL3" sourceRef="GW_RegJoin" targetRef="Task_QueryBalance" />
    <bpmn:sequenceFlow id="FHL4" sourceRef="Task_QueryBalance" targetRef="Task_ApplyDiscount" />
    <bpmn:sequenceFlow id="FHL5" sourceRef="Task_ApplyDiscount" targetRef="Task_CalcPoints" />
    <bpmn:sequenceFlow id="FHL6" sourceRef="Task_CalcPoints" targetRef="Task_UpdateTier" />
    <bpmn:sequenceFlow id="FHL7" sourceRef="Task_UpdateTier" targetRef="GW_TierUpgrade" />
    <bpmn:sequenceFlow id="FHL_Up_Yes" name="Lên hạng" sourceRef="GW_TierUpgrade" targetRef="Task_PushCongrats" />
    <bpmn:sequenceFlow id="FHL_Up_No" name="Giữ hạng" sourceRef="GW_TierUpgrade" targetRef="GW_MktJoin" />
    <bpmn:sequenceFlow id="FHL8" sourceRef="Task_PushCongrats" targetRef="GW_MktJoin" />
    <bpmn:sequenceFlow id="FHL9" sourceRef="GW_MktJoin" targetRef="Task_LogBehavior" />
    <bpmn:sequenceFlow id="FHL10" sourceRef="Task_LogBehavior" targetRef="GW_MktSegment" />
    <bpmn:sequenceFlow id="FHL_Mkt_Yes" name="Có" sourceRef="GW_MktSegment" targetRef="Task_PersonalPromo" />
    <bpmn:sequenceFlow id="FHL_Mkt_No" name="Không" sourceRef="GW_MktSegment" targetRef="GW_MktEndJoin" />
    <bpmn:sequenceFlow id="FHL11" sourceRef="Task_PersonalPromo" targetRef="GW_MktEndJoin" />
    <bpmn:sequenceFlow id="FHL12" sourceRef="GW_MktEndJoin" targetRef="End_Mkt_Done" />
  </bpmn:process>
