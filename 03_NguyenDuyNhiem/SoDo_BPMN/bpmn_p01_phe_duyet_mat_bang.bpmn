<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P01">
    <bpmn:participant id="Pool_P01" name="HIGHLANDS COFFEE - PHÊ DUYỆT MẶT BẰNG" processRef="Process_P01" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P01" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P01">
      <bpmn:lane id="Lane_BD" name="Phòng Phát Triển Mặt Bằng">
        <bpmn:flowNodeRef>Start_P01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Survey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TrafficCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Survey_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitNegotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BudgetCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Renegotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RenegotiateCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Budget_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BudgetMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ForkAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandoverStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P01_Success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="Phòng Pháp Chế">
        <bpmn:flowNodeRef>Task_LegalAudit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Phòng Tài Chính - Kế Toán">
        <bpmn:flowNodeRef>Task_FinancialModel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BOD" name="Ban Tổng Giám Đốc (CEO / BOD)">
        <bpmn:flowNodeRef>GW_JoinAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_EvalPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Eval_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BOD_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BOD_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BOD_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ContractLoopJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_OwnerAgree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustAppendix</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_P01" name="Kế hoạch mở rộng&#10;được tiếp nhận"><bpmn:outgoing>F_P01_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Survey" name="Khảo sát vị trí &amp;&#10;đo lưu lượng khách"><bpmn:incoming>F_P01_1</bpmn:incoming><bpmn:outgoing>F_P01_2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_TrafficCheck" name="Lưu lượng khách&#10;&gt; 3.000 lượt/ngày?"><bpmn:incoming>F_P01_2</bpmn:incoming><bpmn:outgoing>F_Traffic_Pass</bpmn:outgoing><bpmn:outgoing>F_Traffic_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Survey_Fail" name="Hồ sơ vị trí&#10;đã bị hủy"><bpmn:incoming>F_Traffic_Fail</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_InitNegotiate" name="Đàm phán sơ bộ&#10;giá thuê &amp; cọc"><bpmn:incoming>F_Traffic_Pass</bpmn:incoming><bpmn:outgoing>F_P01_3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_BudgetCheck" name="Giá thuê trong&#10;hạn mức ngân sách?"><bpmn:incoming>F_P01_3</bpmn:incoming><bpmn:outgoing>F_Budget_Ok</bpmn:outgoing><bpmn:outgoing>F_Budget_Over</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Renegotiate" name="Tái thương lượng&#10;giá thuê"><bpmn:incoming>F_Budget_Over</bpmn:incoming><bpmn:outgoing>F_P01_4</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_RenegotiateCheck" name="Đàm phán lại&#10;thành công?"><bpmn:incoming>F_P01_4</bpmn:incoming><bpmn:outgoing>F_Reneg_Yes</bpmn:outgoing><bpmn:outgoing>F_Reneg_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Budget_Fail" name="Dự án bị hủy&#10;do vượt ngân sách"><bpmn:incoming>F_Reneg_No</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_BudgetMerge"><bpmn:incoming>F_Budget_Ok</bpmn:incoming><bpmn:incoming>F_Reneg_Yes</bpmn:incoming><bpmn:outgoing>F_To_Fork</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="GW_ForkAssessment" name="Phân luồng thẩm định&#10;song song"><bpmn:incoming>F_To_Fork</bpmn:incoming><bpmn:outgoing>F_Fork_Legal</bpmn:outgoing><bpmn:outgoing>F_Fork_Fin</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="Task_LegalAudit" name="Thẩm định pháp lý&#10;&amp; quy hoạch PCCC"><bpmn:incoming>F_Fork_Legal</bpmn:incoming><bpmn:outgoing>F_Join_Legal</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_FinancialModel" name="Lập mô hình P&amp;L,&#10;tính hoàn vốn &amp; ROI"><bpmn:incoming>F_Fork_Fin</bpmn:incoming><bpmn:outgoing>F_Join_Fin</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="GW_JoinAssessment" name="Đồng bộ kết quả&#10;thẩm định"><bpmn:incoming>F_Join_Legal</bpmn:incoming><bpmn:incoming>F_Join_Fin</bpmn:incoming><bpmn:outgoing>F_P01_5</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_EvalPassed" name="Cả 2 thẩm định pháp lý&#10;&amp; tài chính đạt chuẩn?"><bpmn:incoming>F_P01_5</bpmn:incoming><bpmn:outgoing>F_Eval_Pass</bpmn:outgoing><bpmn:outgoing>F_Eval_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Eval_Fail" name="Dự án bị từ chối&#10;do thẩm định trượt"><bpmn:incoming>F_Eval_Fail</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_BOD_Review" name="Hội đồng đầu tư&#10;họp xét duyệt hồ sơ"><bpmn:incoming>F_Eval_Pass</bpmn:incoming><bpmn:outgoing>F_P01_6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_BOD_Approve" name="Ban Giám Đốc&#10;phê duyệt?"><bpmn:incoming>F_P01_6</bpmn:incoming><bpmn:outgoing>F_BOD_Pass</bpmn:outgoing><bpmn:outgoing>F_BOD_Reject</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_BOD_Reject" name="Dự án bị Ban Giám Đốc&#10;từ chối phê duyệt"><bpmn:incoming>F_BOD_Reject</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_ContractLoopJoin"><bpmn:incoming>F_BOD_Pass</bpmn:incoming><bpmn:incoming>F_Loop_Back</bpmn:incoming><bpmn:outgoing>F_P01_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_SignContract" name="Soạn thảo, ký kết &amp;&#10;công chứng hợp đồng"><bpmn:incoming>F_P01_7</bpmn:incoming><bpmn:outgoing>F_P01_8</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_OwnerAgree" name="Chủ nhà đồng ý&#10;điều khoản HĐ?"><bpmn:incoming>F_P01_8</bpmn:incoming><bpmn:outgoing>F_Owner_Signed</bpmn:outgoing><bpmn:outgoing>F_Owner_Adjust</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdjustAppendix" name="Thương lượng&#10;điều chỉnh phụ lục"><bpmn:incoming>F_Owner_Adjust</bpmn:incoming><bpmn:outgoing>F_Loop_Back</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_HandoverStore" name="Nhận bàn giao&#10;mặt bằng &amp; khởi công"><bpmn:incoming>F_Owner_Signed</bpmn:incoming><bpmn:outgoing>F_P01_9</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_P01_Success" name="Cửa hàng mới&#10;đã mở thành công"><bpmn:incoming>F_P01_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_P01_1" sourceRef="Start_P01" targetRef="Task_Survey" />
    <bpmn:sequenceFlow id="F_P01_2" sourceRef="Task_Survey" targetRef="GW_TrafficCheck" />
    <bpmn:sequenceFlow id="F_Traffic_Pass" name="Đạt chuẩn" sourceRef="GW_TrafficCheck" targetRef="Task_InitNegotiate" />
    <bpmn:sequenceFlow id="F_Traffic_Fail" name="Không đạt" sourceRef="GW_TrafficCheck" targetRef="End_Survey_Fail" />
    <bpmn:sequenceFlow id="F_P01_3" sourceRef="Task_InitNegotiate" targetRef="GW_BudgetCheck" />
    <bpmn:sequenceFlow id="F_Budget_Ok" name="Hợp lý" sourceRef="GW_BudgetCheck" targetRef="GW_BudgetMerge" />
    <bpmn:sequenceFlow id="F_Budget_Over" name="Vượt mức" sourceRef="GW_BudgetCheck" targetRef="Task_Renegotiate" />
    <bpmn:sequenceFlow id="F_P01_4" sourceRef="Task_Renegotiate" targetRef="GW_RenegotiateCheck" />
    <bpmn:sequenceFlow id="F_Reneg_Yes" name="Thành công" sourceRef="GW_RenegotiateCheck" targetRef="GW_BudgetMerge" />
    <bpmn:sequenceFlow id="F_Reneg_No" name="Thất bại" sourceRef="GW_RenegotiateCheck" targetRef="End_Budget_Fail" />
    <bpmn:sequenceFlow id="F_To_Fork" sourceRef="GW_BudgetMerge" targetRef="GW_ForkAssessment" />
    <bpmn:sequenceFlow id="F_Fork_Legal" sourceRef="GW_ForkAssessment" targetRef="Task_LegalAudit" />
    <bpmn:sequenceFlow id="F_Fork_Fin" sourceRef="GW_ForkAssessment" targetRef="Task_FinancialModel" />
    <bpmn:sequenceFlow id="F_Join_Legal" sourceRef="Task_LegalAudit" targetRef="GW_JoinAssessment" />
    <bpmn:sequenceFlow id="F_Join_Fin" sourceRef="Task_FinancialModel" targetRef="GW_JoinAssessment" />
    <bpmn:sequenceFlow id="F_P01_5" sourceRef="GW_JoinAssessment" targetRef="GW_EvalPassed" />
    <bpmn:sequenceFlow id="F_Eval_Pass" name="Đạt chuẩn" sourceRef="GW_EvalPassed" targetRef="Task_BOD_Review" />
    <bpmn:sequenceFlow id="F_Eval_Fail" name="Không đạt" sourceRef="GW_EvalPassed" targetRef="End_Eval_Fail" />
    <bpmn:sequenceFlow id="F_P01_6" sourceRef="Task_BOD_Review" targetRef="GW_BOD_Approve" />
    <bpmn:sequenceFlow id="F_BOD_Pass" name="Phê duyệt" sourceRef="GW_BOD_Approve" targetRef="GW_ContractLoopJoin" />
    <bpmn:sequenceFlow id="F_BOD_Reject" name="Bác bỏ" sourceRef="GW_BOD_Approve" targetRef="End_BOD_Reject" />
    <bpmn:sequenceFlow id="F_P01_7" sourceRef="GW_ContractLoopJoin" targetRef="Task_SignContract" />
    <bpmn:sequenceFlow id="F_P01_8" sourceRef="Task_SignContract" targetRef="GW_OwnerAgree" />
    <bpmn:sequenceFlow id="F_Owner_Signed" name="Đồng ý ký" sourceRef="GW_OwnerAgree" targetRef="Task_HandoverStore" />
    <bpmn:sequenceFlow id="F_Owner_Adjust" name="Yêu cầu sửa" sourceRef="GW_OwnerAgree" targetRef="Task_AdjustAppendix" />
    <bpmn:sequenceFlow id="F_Loop_Back" name="Sửa xong" sourceRef="Task_AdjustAppendix" targetRef="GW_ContractLoopJoin" />
    <bpmn:sequenceFlow id="F_P01_9" sourceRef="Task_HandoverStore" targetRef="End_P01_Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P01">
    <bpmndi:BPMNPlane id="BPMNPlane_P01" bpmnElement="Collaboration_P01">
      <bpmndi:BPMNShape id="Pool_P01_di" bpmnElement="Pool_P01" isHorizontal="true"><dc:Bounds x="40" y="40" width="2720" height="940" /></bpmndi:BPMNShape>
