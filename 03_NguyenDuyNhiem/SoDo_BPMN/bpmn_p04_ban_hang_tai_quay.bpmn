<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P04_AsIs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P04_AsIs">
    <bpmn:participant id="Pool_Cust" name="Khách Hàng" processRef="Process_Cust" />
    <bpmn:participant id="Pool_HL" name="HIGHLANDS COFFEE" processRef="Process_HL" />
    <bpmn:messageFlow id="MF_Order" name="Gửi yêu cầu món" sourceRef="Task_OrderDrink" targetRef="Task_Greeting" />
    <bpmn:messageFlow id="MF_SuggestAlt" name="Báo hết món" sourceRef="Task_SuggestAlt" targetRef="Task_CustDecideAlt" />
    <bpmn:messageFlow id="MF_GivePager" name="Giao bill &amp; thẻ Pager" sourceRef="Task_PrintTicket" targetRef="Task_TakePager" />
    <bpmn:messageFlow id="MF_Buzz" name="Rung chuông Pager" sourceRef="Task_BuzzPager" targetRef="Task_WaitDrink" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Cust" isExecutable="false">
    <bpmn:startEvent id="Start_Cust" name="Khách đến quán"><bpmn:outgoing>FC1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Queue" name="Xếp hàng chờ gọi món"><bpmn:incoming>FC1</bpmn:incoming><bpmn:outgoing>FC2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_QueueTime" name="Chờ &gt; 10p?"><bpmn:incoming>FC2</bpmn:incoming><bpmn:outgoing>FC_Leave</bpmn:outgoing><bpmn:outgoing>FC_WaitOk</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cust_Leave" name="Bỏ về"><bpmn:incoming>FC_Leave</bpmn:incoming><bpmn:incoming>FC_Alt_No</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_CustOrderLoop"><bpmn:incoming>FC_WaitOk</bpmn:incoming><bpmn:incoming>FC_Alt_Yes</bpmn:incoming><bpmn:outgoing>FC3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_OrderDrink" name="Chọn món, size &amp; vị"><bpmn:incoming>FC3</bpmn:incoming><bpmn:outgoing>FC4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_CustDecideAlt" name="Cân nhắc đổi món"><bpmn:incoming>FC4</bpmn:incoming><bpmn:outgoing>FC5</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_AltChoice" name="Đồng ý đổi?"><bpmn:incoming>FC5</bpmn:incoming><bpmn:outgoing>FC_Alt_Yes</bpmn:outgoing><bpmn:outgoing>FC_Alt_No</bpmn:outgoing><bpmn:outgoing>FC_PayDirect</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_TakePager" name="Cầm thẻ rung tìm bàn"><bpmn:incoming>FC_PayDirect</bpmn:incoming><bpmn:outgoing>FC6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_WaitDrink" name="Ngồi chờ nhận tín hiệu"><bpmn:incoming>FC6</bpmn:incoming><bpmn:outgoing>FC7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_PickupDrink" name="Đến quầy nhận đồ uống"><bpmn:incoming>FC7</bpmn:incoming><bpmn:outgoing>FC8</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Cust_Happy" name="Hoàn tất phục vụ"><bpmn:incoming>FC8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="FC1" sourceRef="Start_Cust" targetRef="Task_Queue" />
    <bpmn:sequenceFlow id="FC2" sourceRef="Task_Queue" targetRef="GW_QueueTime" />
    <bpmn:sequenceFlow id="FC_Leave" name="Bỏ đi" sourceRef="GW_QueueTime" targetRef="End_Cust_Leave" />
    <bpmn:sequenceFlow id="FC_WaitOk" name="Tiếp tục" sourceRef="GW_QueueTime" targetRef="GW_CustOrderLoop" />
    <bpmn:sequenceFlow id="FC3" sourceRef="GW_CustOrderLoop" targetRef="Task_OrderDrink" />
    <bpmn:sequenceFlow id="FC4" sourceRef="Task_OrderDrink" targetRef="Task_CustDecideAlt" />
    <bpmn:sequenceFlow id="FC5" sourceRef="Task_CustDecideAlt" targetRef="GW_AltChoice" />
    <bpmn:sequenceFlow id="FC_Alt_Yes" name="Đồng ý" sourceRef="GW_AltChoice" targetRef="GW_CustOrderLoop" />
    <bpmn:sequenceFlow id="FC_Alt_No" name="Hủy" sourceRef="GW_AltChoice" targetRef="End_Cust_Leave" />
    <bpmn:sequenceFlow id="FC_PayDirect" name="Còn hàng" sourceRef="GW_AltChoice" targetRef="Task_TakePager" />
    <bpmn:sequenceFlow id="FC6" sourceRef="Task_TakePager" targetRef="Task_WaitDrink" />
    <bpmn:sequenceFlow id="FC7" sourceRef="Task_WaitDrink" targetRef="Task_PickupDrink" />
    <bpmn:sequenceFlow id="FC8" sourceRef="Task_PickupDrink" targetRef="End_Cust_Happy" />
  </bpmn:process>
  <bpmn:process id="Process_HL" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HL">
      <bpmn:lane id="Lane_Cashier" name="Thu Ngân (Cashier)">
        <bpmn:flowNodeRef>Start_Cashier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Greeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_POS_InputJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputPOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DrinkAvail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestAlt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PayMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CashPay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DigitalPay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PayJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintTicket</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Barista" name="Quầy Pha Chế (Barista &amp; Bếp)">
        <bpmn:flowNodeRef>Task_GetTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ReworkJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BaristaFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeCoffee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeFreeze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WarmCake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BaristaJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TastePass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReworkDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuzzPager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HL_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Cashier" name="Khách đến quầy"><bpmn:outgoing>FH1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Greeting" name="Chào &amp; tư vấn menu"><bpmn:incoming>FH1</bpmn:incoming><bpmn:outgoing>FH2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_POS_InputJoin"><bpmn:incoming>FH2</bpmn:incoming><bpmn:incoming>FH_Alt_ReInput</bpmn:incoming><bpmn:outgoing>FH_To_POS</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_InputPOS" name="Nhập order vào POS"><bpmn:incoming>FH_To_POS</bpmn:incoming><bpmn:outgoing>FH3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_DrinkAvail" name="Còn đủ món?"><bpmn:incoming>FH3</bpmn:incoming><bpmn:outgoing>FH_Avail_Yes</bpmn:outgoing><bpmn:outgoing>FH_Avail_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_SuggestAlt" name="Báo hết &amp; tư vấn đổi"><bpmn:incoming>FH_Avail_No</bpmn:incoming><bpmn:outgoing>FH_Alt_ReInput</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_PayMethod" name="Hình thức TT?"><bpmn:incoming>FH_Avail_Yes</bpmn:incoming><bpmn:outgoing>FH_Pay_Cash</bpmn:outgoing><bpmn:outgoing>FH_Pay_Dig</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_CashPay" name="Thu tiền mặt"><bpmn:incoming>FH_Pay_Cash</bpmn:incoming><bpmn:outgoing>FH_PJ1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_DigitalPay" name="Quẹt thẻ / VietQR"><bpmn:incoming>FH_Pay_Dig</bpmn:incoming><bpmn:outgoing>FH_PJ2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_PayJoin"><bpmn:incoming>FH_PJ1</bpmn:incoming><bpmn:incoming>FH_PJ2</bpmn:incoming><bpmn:outgoing>FH4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrintTicket" name="In bill &amp; giao Pager"><bpmn:incoming>FH4</bpmn:incoming><bpmn:outgoing>FH5_SeqToBar</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_GetTicket" name="Barista dán bill quầy bar"><bpmn:incoming>FH5_SeqToBar</bpmn:incoming><bpmn:outgoing>FH6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_ReworkJoin"><bpmn:incoming>FH6</bpmn:incoming><bpmn:incoming>FH_Rework_Loop</bpmn:incoming><bpmn:outgoing>FH7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="GW_BaristaFork" name="Phân loại trạm pha?"><bpmn:incoming>FH7</bpmn:incoming><bpmn:outgoing>FH_B1</bpmn:outgoing><bpmn:outgoing>FH_B2</bpmn:outgoing><bpmn:outgoing>FH_B3</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:task id="Task_MakeCoffee" name="Pha Cà phê Phin / Espresso"><bpmn:incoming>FH_B1</bpmn:incoming><bpmn:outgoing>FH_J1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_MakeFreeze" name="Xay Freeze &amp; bơm kem"><bpmn:incoming>FH_B2</bpmn:incoming><bpmn:outgoing>FH_J2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_WarmCake" name="Bếp: Nướng bánh mì que"><bpmn:incoming>FH_B3</bpmn:incoming><bpmn:outgoing>FH_J3</bpmn:outgoing></bpmn:task>
    <bpmn:inclusiveGateway id="GW_BaristaJoin" name="Gom đủ món"><bpmn:incoming>FH_J1</bpmn:incoming><bpmn:incoming>FH_J2</bpmn:incoming><bpmn:incoming>FH_J3</bpmn:incoming><bpmn:outgoing>FH8</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:task id="Task_QualityCheck" name="Kiểm tra cảm quan SOP"><bpmn:incoming>FH8</bpmn:incoming><bpmn:outgoing>FH9</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_TastePass" name="Đạt chuẩn?"><bpmn:incoming>FH9</bpmn:incoming><bpmn:outgoing>FH_Pass</bpmn:outgoing><bpmn:outgoing>FH_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReworkDrink" name="Hủy ly hỏng &amp; làm lại"><bpmn:incoming>FH_Fail</bpmn:incoming><bpmn:outgoing>FH_Rework_Loop</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_BuzzPager" name="Bấm máy rung thẻ Pager"><bpmn:incoming>FH_Pass</bpmn:incoming><bpmn:outgoing>FH10</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_HL_Done" name="Hoàn tất đơn"><bpmn:incoming>FH10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="FH1" sourceRef="Start_Cashier" targetRef="Task_Greeting" />
    <bpmn:sequenceFlow id="FH2" sourceRef="Task_Greeting" targetRef="GW_POS_InputJoin" />
    <bpmn:sequenceFlow id="FH_Alt_ReInput" name="Món mới" sourceRef="Task_SuggestAlt" targetRef="GW_POS_InputJoin" />
    <bpmn:sequenceFlow id="FH_To_POS" sourceRef="GW_POS_InputJoin" targetRef="Task_InputPOS" />
    <bpmn:sequenceFlow id="FH3" sourceRef="Task_InputPOS" targetRef="GW_DrinkAvail" />
    <bpmn:sequenceFlow id="FH_Avail_Yes" name="Còn" sourceRef="GW_DrinkAvail" targetRef="GW_PayMethod" />
    <bpmn:sequenceFlow id="FH_Avail_No" name="Hết" sourceRef="GW_DrinkAvail" targetRef="Task_SuggestAlt" />
    <bpmn:sequenceFlow id="FH_Pay_Cash" name="Tiền mặt" sourceRef="GW_PayMethod" targetRef="Task_CashPay" />
    <bpmn:sequenceFlow id="FH_Pay_Dig" name="Thẻ/QR" sourceRef="GW_PayMethod" targetRef="Task_DigitalPay" />
    <bpmn:sequenceFlow id="FH_PJ1" sourceRef="Task_CashPay" targetRef="GW_PayJoin" />
    <bpmn:sequenceFlow id="FH_PJ2" sourceRef="Task_DigitalPay" targetRef="GW_PayJoin" />
    <bpmn:sequenceFlow id="FH4" sourceRef="GW_PayJoin" targetRef="Task_PrintTicket" />
    <bpmn:sequenceFlow id="FH5_SeqToBar" sourceRef="Task_PrintTicket" targetRef="Task_GetTicket" />
    <bpmn:sequenceFlow id="FH6" sourceRef="Task_GetTicket" targetRef="GW_ReworkJoin" />
    <bpmn:sequenceFlow id="FH_Rework_Loop" name="Làm lại" sourceRef="Task_ReworkDrink" targetRef="GW_ReworkJoin" />
    <bpmn:sequenceFlow id="FH7" sourceRef="GW_ReworkJoin" targetRef="GW_BaristaFork" />
    <bpmn:sequenceFlow id="FH_B1" name="Cà phê" sourceRef="GW_BaristaFork" targetRef="Task_MakeCoffee" />
    <bpmn:sequenceFlow id="FH_B2" name="Freeze" sourceRef="GW_BaristaFork" targetRef="Task_MakeFreeze" />
    <bpmn:sequenceFlow id="FH_B3" name="Bánh mì" sourceRef="GW_BaristaFork" targetRef="Task_WarmCake" />
    <bpmn:sequenceFlow id="FH_J1" sourceRef="Task_MakeCoffee" targetRef="GW_BaristaJoin" />
    <bpmn:sequenceFlow id="FH_J2" sourceRef="Task_MakeFreeze" targetRef="GW_BaristaJoin" />
    <bpmn:sequenceFlow id="FH_J3" sourceRef="Task_WarmCake" targetRef="GW_BaristaJoin" />
    <bpmn:sequenceFlow id="FH8" sourceRef="GW_BaristaJoin" targetRef="Task_QualityCheck" />
    <bpmn:sequenceFlow id="FH9" sourceRef="Task_QualityCheck" targetRef="GW_TastePass" />
    <bpmn:sequenceFlow id="FH_Pass" name="Đạt" sourceRef="GW_TastePass" targetRef="Task_BuzzPager" />
    <bpmn:sequenceFlow id="FH_Fail" name="Hỏng" sourceRef="GW_TastePass" targetRef="Task_ReworkDrink" />
    <bpmn:sequenceFlow id="FH10" sourceRef="Task_BuzzPager" targetRef="End_HL_Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P04_AsIs">
    <bpmndi:BPMNPlane id="BPMNPlane_P04_AsIs" bpmnElement="Collaboration_P04_AsIs">
      <bpmndi:BPMNShape id="Pool_Cust_di" bpmnElement="Pool_Cust" isHorizontal="true"><dc:Bounds x="40" y="40" width="2470" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_HL_di" bpmnElement="Pool_HL" isHorizontal="true"><dc:Bounds x="40" y="330" width="2470" height="630" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Cashier_di" bpmnElement="Lane_Cashier" isHorizontal="true"><dc:Bounds x="70" y="330" width="2440" height="290" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Barista_di" bpmnElement="Lane_Barista" isHorizontal="true"><dc:Bounds x="70" y="620" width="2440" height="340" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Cust_di" bpmnElement="Start_Cust"><dc:Bounds x="100" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="75" y="155" width="85" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Queue_di" bpmnElement="Task_Queue"><dc:Bounds x="190" y="95" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_QueueTime_di" bpmnElement="GW_QueueTime" isMarkerVisible="true"><dc:Bounds x="380" y="108" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="365" y="75" width="75" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cust_Leave_di" bpmnElement="End_Cust_Leave"><dc:Bounds x="384" y="205" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="385" y="245" width="35" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_CustOrderLoop_di" bpmnElement="GW_CustOrderLoop" isMarkerVisible="true"><dc:Bounds x="480" y="108" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OrderDrink_di" bpmnElement="Task_OrderDrink"><dc:Bounds x="580" y="95" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CustDecideAlt_di" bpmnElement="Task_CustDecideAlt"><dc:Bounds x="780" y="95" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_AltChoice_di" bpmnElement="GW_AltChoice" isMarkerVisible="true"><dc:Bounds x="980" y="108" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="965" y="75" width="75" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TakePager_di" bpmnElement="Task_TakePager"><dc:Bounds x="1500" y="95" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WaitDrink_di" bpmnElement="Task_WaitDrink"><dc:Bounds x="1950" y="95" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PickupDrink_di" bpmnElement="Task_PickupDrink"><dc:Bounds x="2190" y="95" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cust_Happy_di" bpmnElement="End_Cust_Happy"><dc:Bounds x="2410" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2385" y="155" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Cashier_di" bpmnElement="Start_Cashier"><dc:Bounds x="100" y="442" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="69" y="422" width="98" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Greeting_di" bpmnElement="Task_Greeting"><dc:Bounds x="190" y="425" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_POS_InputJoin_di" bpmnElement="GW_POS_InputJoin" isMarkerVisible="true"><dc:Bounds x="380" y="438" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InputPOS_di" bpmnElement="Task_InputPOS"><dc:Bounds x="480" y="425" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_DrinkAvail_di" bpmnElement="GW_DrinkAvail" isMarkerVisible="true"><dc:Bounds x="680" y="438" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="664" y="416" width="77" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SuggestAlt_di" bpmnElement="Task_SuggestAlt"><dc:Bounds x="780" y="525" width="140" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_PayMethod_di" bpmnElement="GW_PayMethod" isMarkerVisible="true"><dc:Bounds x="980" y="438" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="956" y="416" width="91" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CashPay_di" bpmnElement="Task_CashPay"><dc:Bounds x="1090" y="375" width="130" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DigitalPay_di" bpmnElement="Task_DigitalPay"><dc:Bounds x="1090" y="485" width="130" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_PayJoin_di" bpmnElement="GW_PayJoin" isMarkerVisible="true"><dc:Bounds x="1280" y="438" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrintTicket_di" bpmnElement="Task_PrintTicket"><dc:Bounds x="1380" y="425" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetTicket_di" bpmnElement="Task_GetTicket"><dc:Bounds x="190" y="730" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ReworkJoin_di" bpmnElement="GW_ReworkJoin" isMarkerVisible="true"><dc:Bounds x="380" y="743" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_BaristaFork_di" bpmnElement="GW_BaristaFork"><dc:Bounds x="480" y="743" width="44" height="44" /><bpmndi:BPMNLabel><dc:Bounds x="436" y="707" width="133" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MakeCoffee_di" bpmnElement="Task_MakeCoffee"><dc:Bounds x="580" y="650" width="150" height="65" /></bpmndi:BPMNShape>
