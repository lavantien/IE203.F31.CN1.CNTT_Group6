<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P09" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P09">
    <bpmn:participant id="Pool_P09" name="HIGHLANDS COFFEE - TUYỂN DỤNG &amp; ĐÀO TẠO" processRef="Process_P09" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P09" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P09">
      <bpmn:lane id="Lane_HR" name="Phòng Nhân Sự (HR Dept)">
        <bpmn:flowNodeRef>Start_HR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScreenCV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CVSuitable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fail_CV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HRInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_HRPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fail_HR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CandidateAccept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fail_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Academy" name="Trung Tâm Đào Tạo (Barista Academy)">
        <bpmn:flowNodeRef>Task_ClassTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TrainFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LearnRecipe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LearnService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TrainJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ExamJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SkillExam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ExamPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReTrain</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_StoreOnboard" name="Cửa Hàng Tiếp Nhận (Store Operation)">
        <bpmn:flowNodeRef>Task_OJTStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ProbationPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fail_Probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FormalStaff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HR_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_HR" name="Có nhu cầu tuyển"><bpmn:outgoing>F_H1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_PostJob" name="Đăng tin tuyển dụng"><bpmn:incoming>F_H1</bpmn:incoming><bpmn:outgoing>F_H2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ScreenCV" name="Sàng lọc hồ sơ"><bpmn:incoming>F_H2</bpmn:incoming><bpmn:outgoing>F_H3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_CVSuitable" name="Đạt tiêu chí?"><bpmn:incoming>F_H3</bpmn:incoming><bpmn:outgoing>F_CV_Pass</bpmn:outgoing><bpmn:outgoing>F_CV_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Fail_CV" name="Loại hồ sơ"><bpmn:incoming>F_CV_Fail</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_HRInterview" name="Phỏng vấn trực tiếp"><bpmn:incoming>F_CV_Pass</bpmn:incoming><bpmn:outgoing>F_H4</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_HRPass" name="Trúng tuyển?"><bpmn:incoming>F_H4</bpmn:incoming><bpmn:outgoing>F_HR_Pass</bpmn:outgoing><bpmn:outgoing>F_HR_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Fail_HR" name="Rớt PV"><bpmn:incoming>F_HR_Fail</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_OfferLetter" name="Gửi Offer Letter"><bpmn:incoming>F_HR_Pass</bpmn:incoming><bpmn:outgoing>F_H5</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_CandidateAccept" name="Đồng ý?"><bpmn:incoming>F_H5</bpmn:incoming><bpmn:outgoing>F_Acc_Yes</bpmn:outgoing><bpmn:outgoing>F_Acc_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Fail_Offer" name="Từ chối Offer"><bpmn:incoming>F_Acc_No</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_SignContract" name="Ký HĐ đào tạo"><bpmn:incoming>F_Acc_Yes</bpmn:incoming><bpmn:outgoing>F_H6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ClassTraining" name="Học SOP tại Academy (7 ngày)"><bpmn:incoming>F_H6</bpmn:incoming><bpmn:outgoing>F_H7</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="GW_TrainFork" name="Đào tạo song song"><bpmn:incoming>F_H7</bpmn:incoming><bpmn:outgoing>F_TF1</bpmn:outgoing><bpmn:outgoing>F_TF2</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="Task_LearnRecipe" name="Thực hành pha chế"><bpmn:incoming>F_TF1</bpmn:incoming><bpmn:outgoing>F_TJ1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_LearnService" name="Huấn luyện dịch vụ"><bpmn:incoming>F_TF2</bpmn:incoming><bpmn:outgoing>F_TJ2</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="GW_TrainJoin"><bpmn:incoming>F_TJ1</bpmn:incoming><bpmn:incoming>F_TJ2</bpmn:incoming><bpmn:outgoing>F_H8</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_ExamJoin"><bpmn:incoming>F_H8</bpmn:incoming><bpmn:incoming>F_Re_Back</bpmn:incoming><bpmn:outgoing>F_To_Exam</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_SkillExam" name="Thi sát hạch tay nghề"><bpmn:incoming>F_To_Exam</bpmn:incoming><bpmn:outgoing>F_H9</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_ExamPass" name="Điểm &gt; 80đ?"><bpmn:incoming>F_H9</bpmn:incoming><bpmn:outgoing>F_Ex_Pass</bpmn:outgoing><bpmn:outgoing>F_Ex_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReTrain" name="Đào tạo lại 2 ngày"><bpmn:incoming>F_Ex_Fail</bpmn:incoming><bpmn:outgoing>F_Re_Back</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_OJTStore" name="Thực tập OJT 30 ngày"><bpmn:incoming>F_Ex_Pass</bpmn:incoming><bpmn:outgoing>F_H10</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_ProbationPass" name="Đạt thử việc?"><bpmn:incoming>F_H10</bpmn:incoming><bpmn:outgoing>F_Prob_Pass</bpmn:outgoing><bpmn:outgoing>F_Prob_Fail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Fail_Probation" name="Dừng thử việc"><bpmn:incoming>F_Prob_Fail</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_FormalStaff" name="Ký HĐ chính thức"><bpmn:incoming>F_Prob_Pass</bpmn:incoming><bpmn:outgoing>F_H11</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_HR_Success" name="Barista chính thức"><bpmn:incoming>F_H11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_H1" sourceRef="Start_HR" targetRef="Task_PostJob" />
    <bpmn:sequenceFlow id="F_H2" sourceRef="Task_PostJob" targetRef="Task_ScreenCV" />
    <bpmn:sequenceFlow id="F_H3" sourceRef="Task_ScreenCV" targetRef="GW_CVSuitable" />
    <bpmn:sequenceFlow id="F_CV_Pass" name="Đạt" sourceRef="GW_CVSuitable" targetRef="Task_HRInterview" />
    <bpmn:sequenceFlow id="F_CV_Fail" name="Loại" sourceRef="GW_CVSuitable" targetRef="End_Fail_CV" />
    <bpmn:sequenceFlow id="F_H4" sourceRef="Task_HRInterview" targetRef="GW_HRPass" />
    <bpmn:sequenceFlow id="F_HR_Pass" name="Đậu" sourceRef="GW_HRPass" targetRef="Task_OfferLetter" />
    <bpmn:sequenceFlow id="F_HR_Fail" name="Rớt" sourceRef="GW_HRPass" targetRef="End_Fail_HR" />
    <bpmn:sequenceFlow id="F_H5" sourceRef="Task_OfferLetter" targetRef="GW_CandidateAccept" />
    <bpmn:sequenceFlow id="F_Acc_Yes" name="Nhận" sourceRef="GW_CandidateAccept" targetRef="Task_SignContract" />
    <bpmn:sequenceFlow id="F_Acc_No" name="Từ chối" sourceRef="GW_CandidateAccept" targetRef="End_Fail_Offer" />
    <bpmn:sequenceFlow id="F_H6" sourceRef="Task_SignContract" targetRef="Task_ClassTraining" />
    <bpmn:sequenceFlow id="F_H7" sourceRef="Task_ClassTraining" targetRef="GW_TrainFork" />
    <bpmn:sequenceFlow id="F_TF1" sourceRef="GW_TrainFork" targetRef="Task_LearnRecipe" />
    <bpmn:sequenceFlow id="F_TF2" sourceRef="GW_TrainFork" targetRef="Task_LearnService" />
    <bpmn:sequenceFlow id="F_TJ1" sourceRef="Task_LearnRecipe" targetRef="GW_TrainJoin" />
    <bpmn:sequenceFlow id="F_TJ2" sourceRef="Task_LearnService" targetRef="GW_TrainJoin" />
    <bpmn:sequenceFlow id="F_H8" sourceRef="GW_TrainJoin" targetRef="GW_ExamJoin" />
    <bpmn:sequenceFlow id="F_Re_Back" name="Thi lại" sourceRef="Task_ReTrain" targetRef="GW_ExamJoin" />
    <bpmn:sequenceFlow id="F_To_Exam" sourceRef="GW_ExamJoin" targetRef="Task_SkillExam" />
    <bpmn:sequenceFlow id="F_H9" sourceRef="Task_SkillExam" targetRef="GW_ExamPass" />
    <bpmn:sequenceFlow id="F_Ex_Pass" name="Đạt" sourceRef="GW_ExamPass" targetRef="Task_OJTStore" />
    <bpmn:sequenceFlow id="F_Ex_Fail" name="Trượt" sourceRef="GW_ExamPass" targetRef="Task_ReTrain" />
    <bpmn:sequenceFlow id="F_H10" sourceRef="Task_OJTStore" targetRef="GW_ProbationPass" />
    <bpmn:sequenceFlow id="F_Prob_Pass" name="Đạt" sourceRef="GW_ProbationPass" targetRef="Task_FormalStaff" />
    <bpmn:sequenceFlow id="F_Prob_Fail" name="Loại" sourceRef="GW_ProbationPass" targetRef="End_Fail_Probation" />
    <bpmn:sequenceFlow id="F_H11" sourceRef="Task_FormalStaff" targetRef="End_HR_Success" />
  </bpmn:process>
